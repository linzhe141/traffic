{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.vue", "apps/**/*.mts", "packages/**/*.ts"]
}

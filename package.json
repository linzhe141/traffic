{
  "name": "local-traffic",
  "version": "0.1.0",
  "private": true,
  "description": "A personal local HTTP traffic inspector",
  "license": "UNLICENSED",
  "author": "Local Traffic",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "build": "vue-tsc --noEmit && electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --vue-plugin src scripts forge.config.ts vite.main.config.mts vite.preload.config.mts vite.renderer.config.mts",
    "format": "oxfmt src scripts forge.config.ts vite.main.config.mts vite.preload.config.mts vite.renderer.config.mts package.json tsconfig.json",
    "format:check": "pnpm format --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^45.2.3",
    "extract-zip": "2.0.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.0",
    "vite": "^8.3.6",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.2"
}

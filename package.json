{
  "name": "local-traffic-workspace",
  "version": "0.0.1-test.1",
  "private": true,
  "description": "A personal local HTTP traffic inspector",
  "license": "UNLICENSED",
  "author": "Local Traffic",
  "scripts": {
    "start": "pnpm --filter local-traffic start",
    "dev": "pnpm --filter local-traffic dev",
    "build": "pnpm typecheck && pnpm package",
    "package": "pnpm --filter local-traffic package",
    "make": "pnpm --filter local-traffic make",
    "typecheck": "vue-tsc --noEmit",
    "build:cli": "pnpm --filter @local-traffic/cli build",
    "test:cli": "pnpm build:cli && node --test tests/cli-protocol.test.mjs",
    "lint": "oxlint --vue-plugin apps packages tests",
    "format": "oxfmt apps packages tests package.json pnpm-workspace.yaml tsconfig.json",
    "format:check": "pnpm format --check"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
